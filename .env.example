# Kosmo environment variables.
# Copy to .env.local for the Next.js app. Variables marked [convex] are NOT read
# from this file: set them on your Convex deployment with `npx convex env set NAME value`.

# --- Convex (written to .env.local by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
# Client URL, e.g. https://<name>.convex.cloud
NEXT_PUBLIC_CONVEX_URL=
# HTTP actions URL, e.g. https://<name>.convex.site (used by the auth proxy)
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Site ---
# Public origin of the web app, no trailing slash. Used for canonical URLs, Open Graph,
# robots.txt, sitemap.xml and JSON-LD. Falls back to the Vercel production domain, then localhost.
# (Better Auth reads its own SITE_URL from the Convex environment, see below.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Speech (read by the Next.js API routes) ---
# Deepgram key with Member permissions (needed to mint temporary browser tokens).
DEEPGRAM_API_KEY=
# Rumik SILK text-to-speech.
SILK_API_KEY=
SILK_BASE_URL=https://silk-api.rumik.ai
# Voice model for female personas: muga (tone-steered) or mulberry (description-steered).
SILK_MODEL=muga

# --- [convex] Set these on the Convex deployment, not here ---
# npx convex env set SITE_URL http://localhost:3000       # app origin for Better Auth (BETTER_AUTH_URL also works)
# npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
# npx convex env set GEMINI_API_KEY ...              # text chat (GOOGLE_API_KEY is accepted as a fallback)
# npx convex env set GOOGLE_CHAT_MODEL gemini-2.5-flash    # optional
# npx convex env set OPENROUTER_API_KEY ...          # voice calls
# npx convex env set OPENROUTER_MODEL google/gemini-3.1-flash-lite-preview   # optional

# --- Scripts only ---
# Used by `pnpm generate:portraits` (Gemini image model).
# GEMINI_API_KEY=

# The optional Pipecat server has its own file: voice-agent/server/.env.example
