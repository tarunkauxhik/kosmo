{
  "name": "kosmo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n \"next,convex\" -c \"blue,green\" \"next dev\" \"convex dev\"",
    "dev:web": "next dev",
    "dev:convex": "convex dev",
    "dev:voice": "cd voice-agent/server && uv run bot.py",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "seed": "node scripts/seed-counsellors-to-convex.mjs",
    "generate:portraits": "node scripts/generate-portraits.mjs",
    "emoji:fetch": "tsx scripts/fetch-emoji.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.47.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@google/genai": "^2.30.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
